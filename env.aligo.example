# Naver Monitor 환경 변수 설정 예시
# 이 파일을 .env로 복사하여 사용하세요

# ============================================================
# 알리고 SMS API 설정
# ============================================================
# https://smartsms.aligo.in/ 에서 회원가입 후 발급받은 정보 입력
ALIGO_API_KEY=9b9k0rrbulid5g453yntxaopnor23e9h
ALIGO_USER_ID=amiro
ALIGO_SENDER=01040396287

# ============================================================
# OpenAI API 설정 (AI 블로그 자동 작성)
# ============================================================
# https://platform.openai.com/api-keys 에서 API Key 발급
OPENAI_API_KEY=sk-proj-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# 사용 방법:
# 1. OpenAI API Key:
#    - https://platform.openai.com/api-keys 접속
#    - "Create new secret key" 클릭
#    - 생성된 키를 위에 입력
#
# 2. 알리고 SMS:
#    - https://smartsms.aligo.in/ 접속하여 회원가입
#    - API 연동 > API Key 발급
#    - 발신번호 등록 (본인 인증 필요)
#    - 발급받은 정보를 위에 입력
#
# 3. .env 파일에 추가:
#    cp env.aligo.example .env
#    nano .env

