# 가장 안정적인 Dockerfile (Python 공식 이미지 기반)
FROM python:3.9

# 환경 변수
ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PIP_NO_CACHE_DIR=1

WORKDIR /app

# 시스템 의존성 (최소한만)
RUN apt-get update && \
    apt-get install -y curl && \
    apt-get clean && \
    rm -rf /var/lib/apt/lists/*

# Python 패키지 설치
COPY requirements.txt .
RUN pip install --upgrade pip && \
    pip install -r requirements.txt

# Playwright 설치
RUN playwright install --with-deps chromium

# 앱 코드 복사
COPY server-debug.py .
COPY init-db.py .

# 디렉토리 생성
RUN mkdir -p /app/logs /app/blog_posts

EXPOSE 8000

# 헬스체크
HEALTHCHECK --interval=30s --timeout=10s --start-period=40s \
    CMD curl -f http://localhost:8000/ || exit 1

# 실행
CMD ["python", "-m", "uvicorn", "server-debug:app", "--host", "0.0.0.0", "--port", "8000"]

